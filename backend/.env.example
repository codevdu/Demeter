# Porta em que a aplicação Node.js irá rodar (ex: 3333)
PORT=

# URL de conexão com o banco de dados via Pooler/Proxy (ex: Supabase, Neon)
DATABASE_URL=

# URL de conexão direta com o banco de dados (usada para migrations do Prisma/ORM)
DIRECT_URL=

# Chave secreta para assinatura e verificação dos tokens JWT
JWT_SECRET=

# Ambiente de execução da aplicação (development, staging, production)
NODE_ENV=

# URL base da API do SICAR (Sistema de Cadastro Ambiental Rural)
API_SICAR=

# Token de autenticação ou API Key para acesso ao serviço do SICAR
TOKEN_SICAR=

# (Opcional) URL pública da API para o Swagger e mensagens do console
API_URL=

# (Opcional) Credenciais de acesso da documentação Swagger (/docs)
DOCS_USER=
DOCS_PASSWORD=

# URL do Frontend permitida no CORS
FRONT_URL=

# URL de analise de dados
DATA_SERVICE_URL=
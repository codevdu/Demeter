generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["demeter"]
}

enum Profile {
  PRODUTOR
  TECNICO
  GESTOR
  @@schema("demeter")
}

model User {
  id              String      @id @default(uuid())
  name            String
  cpfCnpj         String      @unique
  email           String      @unique
  passwordHash    String
  profile         Profile        @default(PRODUTOR)

  coordinates     String?      
  state           String?  

  carProperties   CarProperty[]

  @@schema("demeter")
}

model CarProperty {
  id              String   @id @default(uuid())
  carReceipt      String   @unique 
  municipality    String
  municipalityId  Int    

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  @@schema("demeter")
}